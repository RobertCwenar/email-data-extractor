{
  "name": "email-data-extractor",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && uv sync",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      }
    }
  }
}

